---
import Layout from '../../layouts/main.astro';
import { services } from '@/lib/services';
import { company } from '@/lib/company';

export function getStaticPaths() {
	return services.map((service) => ({
		params: { slug: service.slug },
		props: { service },
	}));
}

const { service } = Astro.props;
const base = import.meta.env.BASE_URL;

const otherServices = services.filter((s) => s.slug !== service.slug);

const serviceSchema = {
	"@type": "Service",
	"name": service.title,
	"description": service.description,
	"provider": { "@type": "Organization", "name": company.name, "url": Astro.site?.toString() },
	"areaServed": { "@type": "Country", "name": "Ecuador" },
};

const breadcrumbSchema = {
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Inicio", "item": new URL(base, Astro.site).toString() },
		{ "@type": "ListItem", "position": 2, "name": "Servicios", "item": new URL('/servicios', Astro.site).toString() },
		{ "@type": "ListItem", "position": 3, "name": service.title, "item": new URL(`/servicios/${service.slug}`, Astro.site).toString() },
	],
};
---

<Layout
	title={`${service.title} en Ambato, Ecuador | Nukay`}
	description={`${service.description} Nukay, empresa de desarrollo de software en Ambato, Ecuador.`}
	schema={[serviceSchema, breadcrumbSchema]}
>
	<article class="py-20 md:py-32">
		<div class="container mx-auto px-4">
			<div class="max-w-3xl mx-auto">
				<a href={`${base}servicios`} class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors mb-8">
					← Todos los servicios
				</a>

				<h1 class="text-4xl md:text-5xl font-bold mb-4">
					{service.title} en Ambato, Ecuador
				</h1>
				<p class="text-xl text-muted-foreground mb-12">{service.summary}</p>

				<div class="prose prose-lg dark:prose-invert max-w-none">
					<p>{service.description}</p>
					<p>
						Nukay es una empresa ecuatoriana de desarrollo de software con sede en Ambato,
						Tungurahua. Trabajamos con empresas de todo Ecuador que necesitan {service.title.toLowerCase()}
						{" "}hecho a la medida de su operación, no una solución genérica.
					</p>
				</div>

				<div class="mt-16 pt-8 border-t">
					<h2 class="text-2xl font-bold mb-6">Otros servicios</h2>
					<div class="grid sm:grid-cols-3 gap-4">
						{otherServices.map((s) => (
							<a
								href={`${base}servicios/${s.slug}`}
								class="p-4 rounded-xl border bg-card hover:border-primary transition-colors text-sm font-medium"
							>
								{s.title}
							</a>
						))}
					</div>
				</div>

				<div class="mt-12 text-center">
					<a
						href={`${base}#contacto`}
						class="inline-flex items-center justify-center h-10 px-6 rounded-md bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors"
					>
						Hablemos de tu proyecto
					</a>
				</div>
			</div>
		</div>
	</article>
</Layout>
