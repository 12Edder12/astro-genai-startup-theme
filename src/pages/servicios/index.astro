---
import Layout from '../../layouts/main.astro';
import { services } from '@/lib/services';

const base = import.meta.env.BASE_URL;

const breadcrumbSchema = {
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Inicio", "item": new URL(base, Astro.site).toString() },
		{ "@type": "ListItem", "position": 2, "name": "Servicios", "item": new URL('/servicios', Astro.site).toString() },
	],
};
---

<Layout
	title="Servicios de Desarrollo de Software | Nukay - Ambato, Ecuador"
	description="Servicios de Nukay en Ambato, Ecuador: desarrollo de software a medida, optimización de procesos, seguridad informática y consultoría en tecnología."
	schema={[breadcrumbSchema]}
>
	<section class="py-20 md:py-32">
		<div class="container mx-auto px-4">
			<div class="max-w-3xl mx-auto text-center mb-16">
				<h1 class="text-4xl md:text-5xl font-bold mb-4">
					Servicios de desarrollo de software en Ambato, Ecuador
				</h1>
				<p class="text-xl text-muted-foreground">
					Esto es lo que hacemos en Nukay para empresas ecuatorianas.
				</p>
			</div>

			<div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
				{services.map((service) => (
					<a
						href={`${base}servicios/${service.slug}`}
						class="group p-8 rounded-2xl border bg-card hover:shadow-lg hover:border-primary transition-all"
					>
						<h2 class="text-2xl font-bold mb-3 group-hover:text-primary transition-colors">
							{service.title}
						</h2>
						<p class="text-muted-foreground mb-4">{service.summary}</p>
						<span class="text-sm font-medium text-primary">Ver más →</span>
					</a>
				))}
			</div>
		</div>
	</section>
</Layout>
